{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Student Performance Analytics System\n",
        "Python with AI mini project using Python, NumPy and Pandas. No machine learning is required.\n",
        "\n",
        "**Before running:** upload `students.csv` using the Colab Files panel. If needed, run the upload cell below."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# If students.csv is not already available in the Colab session, run this cell and choose the file.\n",
        "from google.colab import files\n",
        "uploaded = files.upload()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "DATA_FILE = \"students.csv\"\n",
        "SUBJECTS = [\"Python_Marks\", \"NumPy_Marks\", \"Pandas_Marks\"]\n",
        "PASS_MARK = 40\n",
        "MIN_ATTENDANCE = 75"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def load_student_data(file_path=DATA_FILE):\n",
        "    \"\"\"Load and validate student data.\"\"\"\n",
        "    df = pd.read_csv(file_path)\n",
        "    required = [\"Student_ID\", \"Name\", \"Department\"] + SUBJECTS + [\"Attendance\"]\n",
        "    missing = [col for col in required if col not in df.columns]\n",
        "    if missing:\n",
        "        raise ValueError(f\"Missing required columns: {missing}\")\n",
        "    for col in SUBJECTS + [\"Attendance\"]:\n",
        "        df[col] = pd.to_numeric(df[col], errors=\"raise\")\n",
        "    if df.empty:\n",
        "        raise ValueError(\"Dataset is empty.\")\n",
        "    if df[SUBJECTS].isna().any().any() or df[\"Attendance\"].isna().any():\n",
        "        raise ValueError(\"Marks and attendance cannot be missing.\")\n",
        "    if not df[SUBJECTS].apply(lambda col: col.between(0, 100).all()).all():\n",
        "        raise ValueError(\"Marks must be between 0 and 100.\")\n",
        "    if not df[\"Attendance\"].between(0, 100).all():\n",
        "        raise ValueError(\"Attendance must be between 0 and 100.\")\n",
        "    return df\n",
        "\n",
        "def assign_grade(average):\n",
        "    \"\"\"Return grade based on average marks.\"\"\"\n",
        "    if average >= 90: return \"A+\"\n",
        "    elif average >= 80: return \"A\"\n",
        "    elif average >= 70: return \"B\"\n",
        "    elif average >= 60: return \"C\"\n",
        "    elif average >= 50: return \"D\"\n",
        "    else: return \"F\"\n",
        "\n",
        "def calculate_student_results(df):\n",
        "    \"\"\"Add totals, averages, grades and result statuses.\"\"\"\n",
        "    result = df.copy()\n",
        "    result[\"Total_Marks\"] = result[SUBJECTS].sum(axis=1)\n",
        "    result[\"Average_Marks\"] = np.round(result[SUBJECTS].mean(axis=1), 2)\n",
        "    result[\"Grade\"] = result[\"Average_Marks\"].apply(assign_grade)\n",
        "    result[\"Result\"] = np.where(result[SUBJECTS].ge(PASS_MARK).all(axis=1), \"Pass\", \"Fail\")\n",
        "    result[\"Attendance_Status\"] = np.where(result[\"Attendance\"] >= MIN_ATTENDANCE, \"Satisfactory\", \"Low\")\n",
        "    return result"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Load and inspect the dataset\n",
        "students_df = load_student_data()\n",
        "print(\"Dataset preview:\")\n",
        "display(students_df.head())\n",
        "print(f\"\\nNumber of students: {len(students_df)}\")\n",
        "print(f\"Number of departments: {students_df[\"Department\"].nunique()}\")\n",
        "students_df.info()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Calculate and display each student's results\n",
        "results = calculate_student_results(students_df)\n",
        "display(results[[\"Student_ID\", \"Name\", \"Department\", \"Total_Marks\", \"Average_Marks\", \"Grade\", \"Result\", \"Attendance_Status\"]].sort_values(\"Average_Marks\", ascending=False))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Overall class performance\n",
        "averages = results[\"Average_Marks\"].to_numpy()\n",
        "print(f\"Overall class average: {np.mean(averages):.2f}\")\n",
        "print(f\"Highest student average: {np.max(averages):.2f}\")\n",
        "print(f\"Lowest student average: {np.min(averages):.2f}\")\n",
        "print(f\"Median student average: {np.median(averages):.2f}\")\n",
        "print(f\"Students passed: {(results[\"Result\"] == \"Pass\").sum()}\")\n",
        "print(f\"Students failed: {(results[\"Result\"] == \"Fail\").sum()}\")\n",
        "print(f\"Pass percentage: {results[\"Result\"].eq(\"Pass\").mean() * 100:.2f}%\")\n",
        "print(f\"Attendance >= {MIN_ATTENDANCE}%: {results[\"Attendance_Status\"].eq(\"Satisfactory\").sum()}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Subject-wise performance (loop + NumPy)\n",
        "subject_rows = []\n",
        "for subject in SUBJECTS:\n",
        "    marks = results[subject].to_numpy()\n",
        "    subject_rows.append({\n",
        "        \"Subject\": subject.replace(\"_Marks\", \"\"),\n",
        "        \"Average_Marks\": round(float(np.mean(marks)), 2),\n",
        "        \"Highest_Marks\": int(np.max(marks)),\n",
        "        \"Lowest_Marks\": int(np.min(marks)),\n",
        "        \"Students_Passed\": int((marks >= PASS_MARK).sum())\n",
        "    })\n",
        "subject_summary = pd.DataFrame(subject_rows).sort_values(\"Average_Marks\", ascending=False)\n",
        "display(subject_summary)\n",
        "best = subject_summary.iloc[0]\n",
        "print(f\"Best-performing subject: {best[\"Subject\"]} (average {best[\"Average_Marks\"]:.2f})\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Department-wise performance\n",
        "department_summary = results.groupby(\"Department\").agg(\n",
        "    Students=(\"Student_ID\", \"count\"),\n",
        "    Average_Marks=(\"Average_Marks\", \"mean\"),\n",
        "    Passed=(\"Result\", lambda values: (values == \"Pass\").sum()),\n",
        "    Average_Attendance=(\"Attendance\", \"mean\")\n",
        ").round(2)\n",
        "display(department_summary)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Top five performers\n",
        "top_students = results.nlargest(5, \"Average_Marks\")[[\"Student_ID\", \"Name\", \"Department\", \"Average_Marks\", \"Grade\"]]\n",
        "display(top_students)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Export results for submission or further review\n",
        "results.to_csv(\"student_analysis_results.csv\", index=False)\n",
        "subject_summary.to_csv(\"subject_wise_summary.csv\", index=False)\n",
        "print(\"Saved student_analysis_results.csv and subject_wise_summary.csv\")"
      ]
    },
 
